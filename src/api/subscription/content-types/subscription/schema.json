{
  "kind": "collectionType",
  "collectionName": "subscriptions",
  "info": {
    "singularName": "subscription",
    "pluralName": "subscriptions",
    "displayName": "Subscription"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "subscription"
    },
    "plan": {
      "type": "enumeration",
      "enum": [
        "monthly",
        "annually"
      ]
    },
    "subscriptionStatus": {
      "type": "enumeration",
      "enum": [
        "active",
        "cancelled",
        "past_due",
        "inactive"
      ]
    },
    "providerSubscriptionId": {
      "type": "string"
    },
    "lastCheckoutSessionId": {
      "type": "string"
    },
    "expiresAt": {
      "type": "datetime"
    }
  }
}
